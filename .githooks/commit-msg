#!/usr/bin/env bash
#
# commit-msg hook: the subject line must read
#
#   MM-DD-YYYY: <short description of the change>
#
# e.g. "11-24-2026: Fix off-by-one in binary search". The date must be a real
# calendar date. It need not be today, so amending or rewording an older
# commit still passes. Only the subject is checked; the body and trailers
# (Co-Authored-By, ...) below it are free-form.
#
# Exempt: the subjects git writes itself for merges and reverts, and the
# fixup!/squash!/amend! markers that `git rebase --autosquash` consumes.
#
# Enable once per clone:  git config core.hooksPath .githooks
# Skip for one commit:    git commit --no-verify
# Tests:                  bash .githooks/test-commit-msg.sh
#
# Plain bash 3.2 (the macOS /bin/bash): no `date` parsing, whose flags differ
# between BSD and GNU.

set -u

MAX_SUBJECT=72   # whole subject line, date prefix included

msg_file=${1:?usage: commit-msg <message-file>}

# git runs this hook before it strips comment lines, so skip them to reach
# the subject, and stop at the scissors line `git commit -v` puts above the
# diff. A message with no subject left fails here rather than falling through
# to git's own empty-message abort: `git commit -m '#12 fix'` keeps its '#'
# line as the subject, and skipping it as a comment would let it through.
cc=$(git config --get core.commentChar 2>/dev/null || true)
case "$cc" in '' | auto) cc='#' ;; esac

subject=
while IFS= read -r line || [ -n "$line" ]; do
  line=${line%$'\r'}
  case "$line" in
    "$cc"*' >8 '*) break ;;
    "$cc"*) continue ;;
  esac
  [[ $line =~ ^[[:space:]]*$ ]] && continue
  subject=$line
  break
done <"$msg_file"

fail() {
  {
    echo "commit-msg: $1"
    [ -n "$subject" ] && echo "  subject:  $subject"
    echo "  expected: MM-DD-YYYY: <short description>"
    echo "  example:  $(date +%m-%d-%Y): Fix off-by-one in binary search"
    echo "  (skip the check for one commit with git commit --no-verify)"
  } >&2
  exit 1
}

[ -n "$subject" ] || fail "no subject line (lines starting with '$cc' are comments)"

case "$subject" in
  "Merge branch "* | "Merge branches "* | "Merge remote-tracking branch "* | \
  "Merge tag "* | "Merge commit "* | "Merge pull request "* | \
  'Revert "'* | "fixup! "* | "squash! "* | "amend! "*)
    exit 0 ;;
esac

re='^([0-9]{2})-([0-9]{2})-([0-9]{4}): ([^[:space:]].*)$'
[[ $subject =~ $re ]] || fail "subject must be MM-DD-YYYY, a colon, one space, then the description"
mm_raw=${BASH_REMATCH[1]}
dd_raw=${BASH_REMATCH[2]}
mm=$((10#$mm_raw))
dd=$((10#$dd_raw))
yyyy=$((10#${BASH_REMATCH[3]}))

case $mm in
  1 | 3 | 5 | 7 | 8 | 10 | 12) days=31 ;;
  4 | 6 | 9 | 11) days=30 ;;
  2)
    if (( (yyyy % 4 == 0 && yyyy % 100 != 0) || yyyy % 400 == 0 )); then days=29; else days=28; fi ;;
  *) fail "month $mm_raw is not 01-12" ;;
esac
(( dd >= 1 && dd <= days )) || fail "day $dd_raw does not exist in $mm_raw/$yyyy"

(( ${#subject} <= MAX_SUBJECT )) ||
  fail "subject is ${#subject} characters; keep it to $MAX_SUBJECT and put detail in the body"

exit 0
