# Generated by Cargo — compiled artifacts and incremental build cache
/target

# Backup files generated by rustfmt
**/*.rs.bk

# Windows debug symbols (MSVC builds)
*.pdb

# Cargo.lock is intentionally NOT ignored here: this is a binary crate
# (see Cargo.toml), and Cargo's guidance is to commit the lockfile for
# executables so builds stay reproducible. Only libraries should ignore it.

# JetBrains (RustRover/CLion) and generic editor artifacts
.idea/
*.iml

# macOS
.DS_Store
